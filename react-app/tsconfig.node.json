{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    /* Node runtime */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    
    /* Types */
    "types": ["node"],
    "esModuleInterop": true,

    /* TS behavior */
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },

  "include": [
  "scripts/**/*.ts",
  "webhook/server/receiver.ts",
  ]
}
